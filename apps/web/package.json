{
  "name": "@usa-open-data-lab/web",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "node scripts/clear-next-fetch-cache.mjs && next build && node scripts/generate-csp.mjs",
    "start": "next start",
    "lint": "eslint .",
    "format": "prettier --write \"src/**/*.{ts,tsx,css,scss,json}\"",
    "format:check": "prettier --check \"src/**/*.{ts,tsx,css,scss,json}\"",
    "type-check": "tsc --noEmit",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest --watch",
    "test:e2e": "playwright test",
    "test:e2e:critical": "playwright test --grep @critical",
    "test:e2e:update-snapshots": "playwright test --update-snapshots",
    "clean": "rm -rf .next .turbo tsconfig.tsbuildinfo",
    "clean:all": "rm -rf .next .turbo tsconfig.tsbuildinfo node_modules",
    "test:a11y": "playwright test --grep @a11y"
  },
  "dependencies": {
    "@usa-open-data-connectors/usa-sources": "^0.1.2",
    "@usa-open-data-lab/ui": "*",
    "next": "^16.3.8",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "recharts": "^3.10.1",
    "zod": "^3.23"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.10.0",
    "@usa-open-data-lab/config-eslint": "*",
    "@usa-open-data-lab/config-tailwind": "*",
    "@usa-open-data-lab/config-typescript": "*",
    "@playwright/test": "^1.62.1",
    "@tailwindcss/postcss": "^4.3.3",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.1.0",
    "@testing-library/user-event": "^14.5.2",
    "@types/jest-axe": "^3.5.9",
    "@types/node": "^22",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^5.0.0",
    "@vitest/coverage-v8": "^3.0.0",
    "eslint": "^9.39.5",
    "jest-axe": "^9.0.0",
    "postcss": "^8.5.28",
    "sass": "^1.86.0",
    "serve": "^14.2.6",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vitest": "^3.0.0"
  }
}

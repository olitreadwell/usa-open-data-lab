{
  "name": "usa-open-data-lab",
  "version": "0.0.0",
  "private": true,
  "packageManager": "npm@10.9.9",
  "engines": {
    "node": ">=22.17.1"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "turbo dev",
    "build": "turbo build",
    "start": "next start",
    "setup": "node scripts/setup.mjs",
    "typecheck": "npm run type-check",
    "lint": "turbo lint",
    "format": "turbo format",
    "format:check": "turbo format:check",
    "test": "turbo test",
    "test:watch": "vitest",
    "test:coverage": "turbo test:coverage",
    "test:e2e": "turbo test:e2e",
    "test:a11y": "turbo test:a11y",
    "perf": "npx --yes @lhci/cli@0.15.1 autorun",
    "smoke": "bash scripts/smoke.sh",
    "check:links": "node scripts/check-internal-links.mjs",
    "check:external-links": "node scripts/check-external-links.mjs",
    "audit": "npm audit --omit=dev --audit-level=high",
    "test:setup": "node --test scripts/setup.test.mjs",
    "check": "npm run format:check && npm run lint && npm run typecheck && npm run test:coverage && node scripts/check-coverage.mjs && npm run build && npm run smoke && npm run test:e2e && npm run check:links",
    "prepare": "husky || true",
    "type-check": "turbo run type-check",
    "test:unit": "turbo test --",
    "test:visual": "turbo test:visual",
    "storybook": "turbo storybook --filter=@usa-open-data-lab/ui",
    "build:storybook": "turbo build-storybook --filter=@usa-open-data-lab/ui",
    "clean": "rm -rf .turbo apps/*/.next apps/*/.turbo apps/*/dist apps/*/tsconfig.tsbuildinfo apps/*/coverage apps/*/playwright-report apps/*/test-results packages/*/.turbo packages/*/dist packages/*/tsconfig.tsbuildinfo packages/*/.rollup.cache packages/*/coverage packages/*/storybook-static",
    "clean:all": "rm -rf node_modules apps/*/node_modules packages/*/node_modules .turbo apps/*/.next apps/*/.turbo apps/*/dist apps/*/tsconfig.tsbuildinfo apps/*/coverage apps/*/playwright-report apps/*/test-results packages/*/.turbo packages/*/dist packages/*/tsconfig.tsbuildinfo packages/*/.rollup.cache packages/*/coverage packages/*/storybook-static && npm cache clean --force"
  },
  "lint-staged": {
    "*.{ts,tsx,js,mjs,cjs,json,md,css,scss,yml,yaml}": "prettier --write",
    "*.{ts,tsx,js,mjs}": "eslint --fix --no-warn-ignored"
  },
  "overrides": {
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "tar": "^7.5.22",
    "js-yaml": "^4.3.2",
    "smol-toml": "^1.6.1",
    "@tootallnate/once": "2.0.1",
    "on-headers": "1.1.0",
    "@vercel/node": {
      "undici": "^6.28.0",
      "path-to-regexp": "^8.4.2"
    },
    "vercel": {
      "undici": "^6.28.0"
    },
    "@vercel/express": {
      "path-to-regexp": "^8.4.2"
    },
    "@vercel/hono": {
      "path-to-regexp": "^8.4.2"
    },
    "@vercel/remix-builder": {
      "path-to-regexp": "^8.4.2"
    },
    "@vercel/static-config": {
      "ajv": "^8.20.0"
    },
    "@vercel/nft": {
      "brace-expansion": "^5.0.12"
    },
    "serve-handler": {
      "minimatch": "^3.1.4"
    },
    "@vercel/python-analysis": {
      "minimatch": "^10.2.3"
    },
    "@vercel/fun": {
      "path-to-regexp": "^8.4.2"
    },
    "@vercel/backends": {
      "path-to-regexp": "^8.4.2"
    },
    "ajv@8.6.3": "8.20.0",
    "uuid": "11.1.1"
  },
  "devDependencies": {
    "@types/node": "26.3.0",
    "eslint": "^9.39.5",
    "husky": "^9.1.7",
    "prettier": "^3.9.9",
    "typescript": "7.0.2",
    "@clack/prompts": "^0.7",
    "@eslint/js": "^9.39.5",
    "@trivago/prettier-plugin-sort-imports": "^6.0.2",
    "globals": "^17.4.0",
    "lint-staged": "^15.5.2",
    "prettier-plugin-tailwindcss": "^0.6.11",
    "turbo": "^2.5.6",
    "vercel": "59.1.4"
  },
  "dependencies": {},
  "description": "USA Data Lab (scaffold, derived from nz-open-data-lab)"
}
